          <span class="chip">Git</span>
          <span class="chip">MongoDB</span> -->
          <span class="chip add">+</span>
        </div>

        <div class="field-label">Faixa de Preço (por hora)</div>
        <div class="slider-row">
          <div class="range-inputs">
            <input type="text" id="inputs-faixapreco" value="R$ 0,00">
            <span>-</span>
            <input type="text" id="inputs-faixapreco" value="R$ 0,00">
          </div>
        </div>

        <div class="field-label">Avaliação Mínima</div>
        <div class="stars-select">
          <!-- <span class="txt">3+ <i class="fa-solid fa-star"></i>, 4+ <i class="fa-solid fa-star"></i></span>
          <i class="fa-solid fa-chevron-down"></i> -->
        </div>

        <div class="field-label">Nível</div>
        <select class="field">
           <option>Todos os níveis</option>
          <option>Nível 1+</option>
          <option>Nível 3+</option>
          <option>Nível 5+</option>
        </select>

        <div class="field-label">Disponibilidade</div>
        <div class="stars-select">
          <!-- <span class="txt">Disponível agora</span>
          <i class="fa-solid fa-chevron-down"></i> -->
        </div>
      </section>


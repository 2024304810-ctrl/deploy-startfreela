<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Detalhes do Projeto | Start-Freela</title>

    <link rel="stylesheet" href="/css/proposal.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>

<body>

    <!-- CABEÇALHO -->
    <header class="topbar">
  <a href="/home" class="logo">
      <img id="logo-image" src="/img/logo-deitada.png" alt="StartFreela">
  </a>

  <div class="search-wrap">
    <i id="icon" class="fa-solid fa-magnifying-glass"></i>
    <input type="text" name="search" id="search" placeholder="Busque em StartFreela...">
  </div>

  <div class="top-actions">
    <a class="icon-btn" href="/notifications"><i class="fa-solid fa-bell"></i><span class="badge">1</span></a>
    <a class="icon-btn" href="/messages"><i class="fa-solid fa-comment-dots"></i><span class="badge">1</span></a>
    <span class="role-pill">{{usuario.role}}</span>
    <div class="avatar-wrap">
      <div class="avatar"><img id="foto-de-perfil" src="/img/foto-do-perfil.png" alt=""></div>
      <i class="fa-solid fa-chevron-down chev"></i>

      <div class="avatar-dropdown">
        <div class="dropdown-header">
          <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
          <span>{{usuario.completeName}}</span>
        </div>
        <a href="#"><i class="fa-solid fa-user"></i> Ver perfil</a>
        <a href="#"><i class="fa-solid fa-briefcase"></i> Meu Portfólio</a>
        <a href="#"><i class="fa-solid fa-file-lines"></i> Serviços e Propostas</a>
        <a href="/settings"><i class="fa-solid fa-gear"></i> Configurações da Conta</a>
        <a href="#" class="dropdown-sair" id="sair" ><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
      </div>
    </div>
  </div>
</header>
    <nav class="subnav">
        <a href="/home">Tela Inicial</a>
        <a href="/freelancers">Freelancers</a>
        <a href="/projects" class="active">Projetos</a>
        <a href="/support">Suporte</a>
    </nav>

    <main class="page-shell">
        <a href="/projects" class="back-link"><i class="fa-solid fa-arrow-left"></i> Voltar para projetos</a>
        <section class="welcome-row">
            <div>
                <p class="eyebrow">OPORTUNIDADE FREELANCER</p>
                <h1>Detalhes do projeto</h1>
                <p class="page-subtitle">Confira as informações e envie uma proposta ao cliente.</p>
            </div>
            <span class="status status-open">
                <i></i> Recebendo propostas
            </span>
        </section>

        <div class="project-layout">
            <div class="main-column">
                <section class="panel project-overview">
                    <div class="overview-top">
                        <div class="project-symbol code">
                            <i class="fa-solid fa-code"></i>
                        </div>
                        <div class="overview-heading">
                            <div class="tag-row">
                                <span>Desenvolvimento Web</span>
                                <span>Projeto remoto</span>
                            </div>
                            <h2>Desenvolvimento de site institucional</h2>
                            <p class="muted">
                                Publicado por
                                <strong>TechSolutions</strong>
                                <span class="verified"><i class="fa-solid fa-check"></i></span>
                            </p>
                            <p class="project-meta">
                                <i class="fa-regular fa-calendar"></i>
                                Publicado há 2 dias
                                <span>·</span>
                                <i class="fa-solid fa-users"></i>
                                18 propostas recebidas
                            </p>
                        </div>
                    </div>

                    <p class="overview-description">
                        Precisamos de um desenvolvedor para criar um site
                        institucional moderno, responsivo e otimizado para
                        mecanismos de busca. O site deverá apresentar a
                        empresa, seus serviços, portfólio e um formulário
                        de contato.
                    </p>

                    <div class="summary-grid">
                        <div class="summary-item">
                            <span class="summary-icon blue">
                                <i class="fa-solid fa-wallet"></i>
                            </span>
                            <div>
                                <small>Orçamento estimado</small>
                                <strong>R$ 1.500 – R$ 3.000</strong>
                                <span>Pagamento por etapas</span>
                            </div>
                        </div>

                        <div class="summary-item">
                            <span class="summary-icon amber">
                                <i class="fa-regular fa-clock"></i>
                            </span>
                            <div>
                                <small>Prazo de entrega</small>
                                <strong>15 a 30 dias</strong>
                                <span>Início imediato</span>
                            </div>
                        </div>

                        <div class="summary-item">
                            <span class="summary-icon purple">
                                <i class="fa-solid fa-location-dot"></i>
                            </span>
                            <div>
                                <small>Modalidade</small>
                                <strong>Remoto</strong>
                                <span>Todo o Brasil</span>
                            </div>
                        </div>
                    </div>

                    <div class="overview-footer">
                        <span>
                            <i class="fa-solid fa-circle-check"></i>
                            Cliente verificado
                        </span>
                        <span>
                            <i class="fa-solid fa-file-lines"></i>
                            Briefing detalhado
                        </span>
                        <span>
                            <i class="fa-solid fa-comments"></i>
                            Comunicação pela plataforma
                        </span>
                    </div>
                </section>

                <section class="panel detail-panel">
                    <div class="section-heading">
                        <span class="section-icon blue">
                            <i class="fa-solid fa-align-left"></i>
                        </span>
                        <div>
                            <h2>Descrição do projeto</h2>
                            <p>O que o cliente precisa</p>
                        </div>
                    </div>

                    <div class="section-body">
                        <p>
                            Desenvolver um site institucional para a
                            TechSolutions, com visual moderno, navegação
                            simples e boa experiência em computadores,
                            tablets e celulares.
                        </p>
                        <p>
                            O site deverá apresentar as seguintes páginas
                            e funcionalidades:
                        </p>
                        <ul>
                            <li>
                                Página inicial com apresentação da empresa
                                e dos principais serviços.
                            </li>
                            <li>
                                Página "Sobre nós", com história, missão
                                e equipe.
                            </li>
                            <li>
                                Página de serviços com informações detalhadas.
                            </li>
                            <li>
                                Portfólio com exemplos de trabalhos realizados.
                            </li>
                            <li>
                                Página de contato com formulário funcional.
                            </li>
                        </ul>
                        <p>
                            O cliente já possui identidade visual e fornecerá
                            os textos e materiais institucionais necessários.
                        </p>
                    </div>
                </section>

                <section class="panel detail-panel">
                    <div class="section-heading">
                        <span class="section-icon amber">
                            <i class="fa-solid fa-list-check"></i>
                        </span>
                        <div>
                            <h2>Responsabilidades</h2>
                            <p>Atividades que deverão ser realizadas</p>
                        </div>
                    </div>

                    <div class="section-body">
                        <ul>
                            <li>
                                Implementar as páginas conforme o briefing aprovado.
                            </li>
                            <li>
                                Garantir a responsividade em diferentes
                                tamanhos de tela.
                            </li>
                            <li>
                                Integrar e testar o formulário de contato.
                            </li>
                            <li>
                                Aplicar boas práticas básicas de SEO
                                e desempenho.
                            </li>
                            <li>
                                Realizar testes, corrigir problemas e
                                entregar o código organizado.
                            </li>
                            <li>
                                Manter o cliente informado sobre o andamento
                                do projeto.
                            </li>
                        </ul>
                    </div>
                </section>

                <section class="panel detail-panel">
                    <div class="section-heading">
                        <span class="section-icon purple">
                            <i class="fa-solid fa-screwdriver-wrench"></i>
                        </span>
                        <div>
                            <h2>Requisitos e habilidades</h2>
                            <p>Conhecimentos esperados pelo cliente</p>
                        </div>
                    </div>

                    <div class="section-body">
                        <ul>
                            <li>Conhecimento de HTML5, CSS3 e JavaScript.</li>
                            <li>Experiência com layouts responsivos.</li>
                            <li>Noções de acessibilidade e SEO.</li>
                            <li>Capacidade de organizar e documentar o código.</li>
                            <li>Boa comunicação e comprometimento com prazos.</li>
                            <li>Portfólio de sites anteriores será um diferencial.</li>
                        </ul>

                        <div class="tag-row skill-tags">
                            <span>HTML</span>
                            <span>CSS</span>
                            <span>JavaScript</span>
                            <span>UI/UX</span>
                            <span>SEO</span>
                            <span>Responsividade</span>
                        </div>
                    </div>
                </section>

                <section class="panel detail-panel">
                    <div class="section-heading">
                        <span class="section-icon green">
                            <i class="fa-solid fa-box-open"></i>
                        </span>
                        <div>
                            <h2>Entregáveis esperados</h2>
                            <p>O que deverá ser entregue ao final</p>
                        </div>
                    </div>

                    <div class="section-body">
                        <ul>
                            <li>Código-fonte completo e organizado.</li>
                            <li>Site funcional e adaptado para celular e computador.</li>
                            <li>Formulário de contato testado.</li>
                            <li>Publicação em hospedagem definida com o cliente.</li>
                            <li>Orientações básicas para atualização do conteúdo.</li>
                        </ul>
                    </div>
                </section>

                <section class="panel detail-panel">
                    <div class="section-heading">
                        <span class="section-icon blue">
                            <i class="fa-solid fa-circle-info"></i>
                        </span>
                        <div>
                            <h2>Informações adicionais</h2>
                            <p>Detalhes importantes antes de enviar sua proposta</p>
                        </div>
                    </div>

                    <div class="section-body">
                        <ul>
                            <li>
                                O pagamento será combinado por etapas com o cliente.
                            </li>
                            <li>
                                O cliente fornecerá textos, logotipo e imagens
                                institucionais.
                            </li>
                            <li>
                                O freelancer deverá informar seu prazo
                                e valor estimados.
                            </li>
                            <li>
                                Envie uma proposta personalizada explicando
                                sua experiência e abordagem.
                            </li>
                        </ul>
                    </div>
                </section>
            </div>

            <aside class="sidebar">
                <section class="panel action-panel">
                    <h2>Tem interesse neste projeto?</h2>
                    <p>
                        Apresente sua experiência e explique como pretende
                        realizar o trabalho.
                    </p>
                    <button class="btn btn-primary btn-block" id="apply-button">
                        <i class="fa-regular fa-paper-plane"></i>
                        Candidatar-se ao projeto
                    </button>
                    <button class="btn btn-outline btn-block" id="save-button">
                        <i class="fa-regular fa-bookmark" id="save-icon"></i>
                        <span id="save-text">Salvar projeto</span>
                    </button>
                    <div class="action-divider"></div>
                    <div class="mini-fact">
                        <i class="fa-solid fa-users"></i>
                        <span>
                            <strong>18 propostas</strong>
                            <small>Enviadas por freelancers</small>
                        </span>
                    </div>

                    <div class="mini-fact">
                        <i class="fa-regular fa-eye"></i>
                        <span>
                            <strong>Mais de 100 visualizações</strong>
                            <small>Esta oportunidade está recebendo atenção</small>
                        </span>
                    </div>
                </section>

                <section class="panel side-panel">
                    <div class="side-panel-heading">
                        <h2>Sobre o cliente</h2>
                        <button class="icon-only" id="client-more"
                                aria-label="Mais informações">
                            <i class="fa-solid fa-ellipsis"></i>
                        </button>
                    </div>

                    <div class="client-profile">
                        <div class="client-avatar">TS</div>
                        <div>
                            <strong>
                                TechSolutions
                                <span class="verified">
                                    <i class="fa-solid fa-check"></i>
                                </span>
                            </strong>
                            <p>Empresa verificada</p>
                        </div>
                    </div>
                    <p class="client-description">
                        Empresa de tecnologia focada em soluções digitais
                        para pequenas e médias empresas.
                    </p>
                    <div class="side-stat">
                        <i class="fa-regular fa-calendar"></i>
                        <span>Membro desde janeiro de 2023</span>
                    </div>
                    <div class="side-stat">
                        <i class="fa-solid fa-folder-open"></i>
                        <span>12 projetos publicados</span>
                    </div>
                    <div class="side-stat">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>8 projetos concluídos</span>
                    </div>
                    <div class="side-stat">
                        <i class="fa-solid fa-star"></i>
                        <span>Avaliação média: 4,8/5</span>
                    </div>
                    <div class="side-stat">
                        <i class="fa-regular fa-clock"></i>
                        <span>Última atividade: há 3 horas</span>
                    </div>
                    <a href="/profile" class="btn btn-outline btn-block profile-link">
                        Ver perfil do cliente
                    </a>
                </section>

                <section class="panel side-panel ranking-panel">
                    <h2>Seu ranking</h2>
                    <strong class="level">Nível 0</strong>
                    <div class="rank-emblem">
                        <i class="fa-solid fa-medal"></i>
                    </div>
                    <div class="progress-track">
                        <span></span>
                    </div>
                    <p>Você possui <strong>0 pontos</strong></p>
                    <small>
                        Restam 100 pontos para o próximo nível.
                    </small>
                </section>

                <section class="security-panel">
                    <div class="security-heading">
                        <i class="fa-solid fa-shield-halved"></i>
                        <h2>Dica de segurança</h2>
                    </div>
                    <p>
                        Mantenha as conversas e os pagamentos dentro
                        da plataforma. Evite compartilhar dados pessoais.
                    </p>
                    <a href="/support">
                        Saiba mais sobre segurança
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </section>
            </aside>
        </div>
    </main>

    <div class="modal-backdrop hidden" id="application-modal" aria-hidden="true">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <div class="modal-header">
                <div>
                    <p class="eyebrow">START-FREELA</p>
                    <h2 id="modal-title">Enviar proposta</h2>
                </div>
                <button class="icon-only" id="close-modal" aria-label="Fechar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <p class="modal-description">Projeto: <strong>Desenvolvimento de site institucional</strong></p>
            <form id="application-form">
                <label for="proposal-price">
                    Valor da proposta (R$)
                </label>
                <input id="proposal-price" type="number" min="1" step="0.01" placeholder="Ex.: 2000" required>
                <label for="proposal-deadline">
                    Prazo estimado (dias)
                </label>
                <input id="proposal-deadline" type="number" min="1" placeholder="Ex.: 20" required>
                <label for="proposal-message">
                    Mensagem para o cliente
                </label>
                <textarea id="proposal-message" rows="5" minlength="20" placeholder="Apresente sua experiência e explique como pretende realizar o projeto..." required></textarea>
                <button class="btn btn-primary btn-block" type="submit">
                    <i class="fa-regular fa-paper-plane"></i>
                    Enviar proposta
                </button>
                <p class="form-feedback" id="form-feedback" role="status"></p>
            </form>
        </section>
    </div>
    <div class="toast hidden" id="toast" role="status"></div>
    
    <script src="/js.components/header-dropdown.js" defer></script>
    <script type="module" src="/js/proposal.js" defer></script>
</body>
</html>
      <!-- Avaliações dos clientes -->
      <section class="panel">
        <div class="header-secao">
          <h2>Avaliações dos Clientes</h2>
          <p>Todas as avaliações abaixo vêm de contratos concluídos e verificados na plataforma.</p>
        </div>

        <div class="resumo-avaliacoes">
          <div class="nota-geral">
            <span class="nota-numero">0</span>

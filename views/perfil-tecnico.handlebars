<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StartFreela - {{perfil.username}}</title>
<link rel="stylesheet" href="/css/tela-de-perfil-freelancer.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>

<header class="topbar">
  <div class="logo">
    <img id="logo-image" src="/img/logo-deitada.png" alt="StartFreela">
  </div>

  <div class="search-wrap">
    <i id="icon" class="fa-solid fa-magnifying-glass"></i>
    <input type="text" name="search" id="search" placeholder="Busque em StartFreela...">
  </div>

  <div class="top-actions">
    <a class="icon-btn" href="/notifications"><i class="fa-solid fa-bell"></i><span class="badge">1</span></a>
    <a class="icon-btn" href="/messages"><i class="fa-solid fa-comment-dots"></i><span class="badge">1</span></a>
    <span class="role-pill">{{usuario.role}}</span>
    <div class="avatar-wrap">
      <div class="avatar"><img id="foto-de-perfil" src="/img/foto-do-perfil.png" alt=""></div>
      <i class="fa-solid fa-chevron-down chev"></i>

      <div class="avatar-dropdown">
        <div class="dropdown-header">
          <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
          <span>{{usuario.completeName}}</span>
        </div>
        <a href="#"><i class="fa-solid fa-user"></i> Ver perfil</a>
        <a href="#"><i class="fa-solid fa-briefcase"></i> Meu Portfólio</a>
        <a href="#"><i class="fa-solid fa-file-lines"></i> Serviços e Propostas</a>
        <a href="/settings"><i class="fa-solid fa-gear"></i> Configurações da Conta</a>
        <a href="#" class="dropdown-sair" id="sair" ><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
      </div>
    </div>
  </div>
</header>

<nav class="subnav">
  <a href="/home">Tela Inicial</a>
  <a href="/freelancers">Freelancers</a>
  <a href="/projects">Projetos</a>
  <a href="/support">Suporte</a>
</nav>

<main>

    <h1 class="page-title">Perfil {{perfil.role}}</h1>

  <div class="layout">

    <!-- COLUNA PRINCIPAL -->
    <div class="col-main">

      <!-- Dados do perfil -->
      <section class="panel">
        <h2>Perfil de {{perfil.username}}</h2>

        <div class="perfil-topo">
          <div class="avatar-grande">
            <img src="/img/icone-user.png" alt="Foto de perfil">
          </div>
          <div class="perfil-dados">
            <div class="perfil-nome-row">
              <h3>{{perfil.completeName}}</h3>
              <span class="selo-verificado-mini" title="Identidade verificada"><i class="fa-solid fa-shield-halved"></i> Verificado</span>
            </div>
            <p class="nome-usuario">@{{perfil.username}}</p>

            {{#if perfil.profissao}}
                <p class="profissao">{{perfil.profissao}}</p>
            {{else}}
                <p class="profissao">--------//--------</p>
            {{/if}}

            <div class="perfil-meta">
              {{#if perfil.localizacao}}
                  <span class="meta-item"><i class="fa-solid fa-location-dot"></i>{{perfil.localizacao}}</span>
              {{else}}
                  <span class="meta-item"><i class="fa-solid fa-location-dot"></i>----//----</span>
              {{/if}}

              {{#if perfil.ativo}}
                <span class="meta-item status-disponivel"><i class="fa-solid fa-circle"></i>Ativo</span>
              {{else}}
                <span class="meta-item status-indisponivel"><i class="fa-solid fa-circle"></i>Inativo</span>
              {{/if}}
            </div>

            <div class="perfil-links">
              <a href="#" class="link-externo"><i class="fa-brands fa-github"></i> GitHub</a>
              <!-- 
              <a href="#" class="link-externo"><i class="fa-brands fa-linkedin"></i> LinkedIn</a>
              <a href="#" class="link-externo"><i class="fa-brands fa-behance"></i> Behance</a> -->
            </div>
          </div>

          <a class="btn-primary btn-editar" id="{{perfil.idUser}}"><i class="fa-solid fa-comment-dots"></i>Conversar</a>
        </div>

        <div class="divisor"></div>

        <div class="bloco">
          <h3 class="titulo-bloco">Sobre Mim</h3>
          <!-- <p class="texto-sobre">Lorem ipsum dolor sit amet, consectetur adipisicing elit. Impedit, eveniet. Necessitatibus voluptatibus animi quis temporibus soluta eligendi ratione, deserunt pariatur asperiores velit, vel illum minus. Voluptates iusto incidunt corporis. Vitae!</p> -->
        </div>

        <div class="bloco">
          <h3 class="titulo-bloco">Habilidades Técnicas</h3>
          <div class="chips">
            <!-- <span class="chip">Node.js</span>

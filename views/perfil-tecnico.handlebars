    <!-- COLUNA LATERAL -->
    <aside class="col-side">

      <section class="panel">
        <h2>Estatísticas</h2>
        <p class="linha-stat">Projetos Concluídos <span class="stat-valor stat-verde">0 <i class="fa-solid fa-check"></i></span></p>
        <p class="linha-stat">Avaliação Média <span class="stat-valor stat-dourado">0 <i class="fa-solid fa-star"></i></span></p>
        <p class="linha-stat">Taxa de Resposta <span class="stat-valor">0%</span></p>
        <p class="linha-stat sem-borda">Membro desde <b>{{perfil.createdIn}}</b></p>
      </section>

      <section class="panel">
        <h2>Ranking</h2>
        <p class="nivel-label">Nível 0</p>
        <img class="img-nivel" src="/img/level-1.png" alt="Nível 5">
        <div class="barra-xp">
          <div class="barra-xp-preenchida" style="width: 0%;"></div>
        </div>
        <p class="pontos-label">Você possui 0 pontos</p>
        <p class="pontos-restam">Restam 100 pontos para o próximo nível</p>
      </section>

      <section class="panel">

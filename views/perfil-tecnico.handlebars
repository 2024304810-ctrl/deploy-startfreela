
<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StartFreela - {{perfil.username}}</title>
  <link rel="stylesheet" href="/css/tela-de-perfil-freelancer.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
    integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<body>

  <header class="topbar">
    <div class="logo">
      <img id="logo-image" src="/img/logo-deitada.png" alt="StartFreela">
    </div>

    <div class="search-wrap">
      <i id="icon" class="fa-solid fa-magnifying-glass"></i>
      <input type="text" name="search" id="search" placeholder="Busque em StartFreela...">
    </div>

    <div class="top-actions">
      <a class="icon-btn" href="/notifications"><i class="fa-solid fa-bell"></i><span class="badge">1</span></a>
      <a class="icon-btn" href="/messages"><i class="fa-solid fa-comment-dots"></i><span class="badge">1</span></a>
      <span class="role-pill">{{usuario.role}}</span>

      <div class="avatar-wrap">
        <div class="avatar">
          <img id="foto-de-perfil" src="/img/foto-do-perfil.png" alt="">
        </div>

        <i class="fa-solid fa-chevron-down chev"></i>

        <div class="avatar-dropdown">
          <div class="dropdown-header">
            <div class="avatar">
              <img src="/img/foto-do-perfil.png" alt="">
            </div>
            <span>{{usuario.completeName}}</span>
          </div>

          <a href="/profile"><i class="fa-solid fa-user"></i> Ver perfil</a>
          <a href="/settings"><i class="fa-solid fa-gear"></i> Configurações</a>
          <a href="#" class="dropdown-sair" id="sair">
            <i class="fa-solid fa-right-from-bracket"></i> Sair
          </a>
        </div>
      </div>
    </div>
  </header>

  <nav class="subnav">
    <a href="/home">Tela Inicial</a>
    <a href="/freelancers">Freelancers</a>
    <a href="/projects">Projetos</a>
    <a href="/support">Suporte</a>
  </nav>

  <main>

    <h1 class="page-title">Perfil {{perfil.role}}</h1>

    <div class="layout">

      <!-- COLUNA PRINCIPAL -->
      <div class="col-main">

        <!-- DADOS DO PERFIL -->
        <section class="panel">
          <h2>Perfil de {{perfil.username}}</h2>

          <div class="perfil-topo">

            <div class="avatar-grande">
              <img src="/img/icone-user.png" alt="Foto de perfil">
            </div>

            <div class="perfil-dados">

              <div class="perfil-nome-row">
                <h3>{{perfil.completeName}}</h3>
              </div>

              <p class="nome-usuario">@{{perfil.username}}</p>

              {{#if perfil.profissao}}
                <p class="profissao">{{perfil.profissao}}</p>
              {{else}}
                <p class="profissao">--------//--------</p>
              {{/if}}

              <div class="perfil-meta">

                {{#if perfil.localizacaoTexto}}
                  <span class="meta-item">
                    <i class="fa-solid fa-location-dot"></i>
                    {{perfil.localizacaoTexto}}
                  </span>
                {{else}}
                  <span class="meta-item">
                    <i class="fa-solid fa-location-dot"></i>
                    Localização não informada
                  </span>
                {{/if}}

                {{#if perfil.ativo}}
                  <span class="meta-item status-disponivel">
                    <i class="fa-solid fa-circle"></i>Ativo
                  </span>
                {{else}}
                  <span class="meta-item status-indisponivel">
                    <i class="fa-solid fa-circle"></i>Inativo
                  </span>
                {{/if}}

              </div>

              <div class="perfil-links">
                {{#each perfil.redesSociais}}
                  <a href="{{this.link}}" class="link-externo" target="_blank" rel="noopener noreferrer">
                    <i class="fa-solid fa-link"></i>
                    {{this.site}}
                  </a>
                {{/each}}
              </div>

            </div>

            {{#unless mesmoUsuario}}
              <a class="btn-primary btn-editar" id="{{perfil.idUser}}">
                <i class="fa-solid fa-comment-dots"></i> Conversar
              </a>
            {{/unless}}

          </div>

          <div class="divisor"></div>

          <!-- SOBRE MIM -->
          <div class="bloco">
            <h3 class="titulo-bloco">Sobre Mim</h3>

            {{#if perfil.sobreMim}}
              <p class="texto-sobre">{{perfil.sobreMim}}</p>
            {{else}}
              <p class="texto-sobre">Este usuário ainda não adicionou uma descrição.</p>
            {{/if}}
          </div>

          <!-- HABILIDADES TÉCNICAS -->
          <div class="bloco">
            <h3 class="titulo-bloco">Habilidades Técnicas</h3>

            <div class="chips">
              {{#if perfil.possuiHabilidades}}
                {{#each perfil.habilidades}}
                  <span class="chip">{{this}}</span>
                {{/each}}
              {{else}}
                <p>Nenhuma habilidade cadastrada.</p>
              {{/if}}
            </div>
          </div>

        </section>

        <!-- PORTFÓLIO: SOMENTE FREELANCER -->
        {{#if ehFreelancer}}

          <section class="panel">
            <div class="header-secao">
              <div class="header-secao-titulo">
                <h2>Portfólio</h2>
                <span class="selo-info">Externo · não verificado</span>
              </div>
            </div>

            <div class="grid-portfolio">

              {{#if projetos.length}}

                {{#each projetos}}
                  <article class="card-projeto" data-projeto="{{this.idProjeto}}">

                    <img src="{{this.imagemCapa}}" alt="{{this.titulo}}">

                    <div class="info-projeto">
                      <h4>{{this.titulo}}</h4>

                      <div class="tags">
                        {{#each this.habilidades}}
                          <span class="tag">{{this}}</span>
                        {{/each}}
                      </div>

                      <a href="/portfolio/projeto?p={{this.idProjeto}}" class="link-projeto">
                        <i class="fa-solid fa-eye"></i>
                        Ver projeto
                      </a>
                    </div>

                  </article>
                {{/each}}

              {{else}}
                <p>Este freelancer ainda não adicionou projetos ao portfólio.</p>
              {{/if}}

            </div>
          </section>

        {{/if}}

        <!-- TRABALHOS REALIZADOS: SOMENTE FREELANCER -->
        {{#if ehFreelancer}}

          <section class="panel">
            <div class="header-secao">
              <div class="header-secao-titulo">
                <h2>Trabalhos Realizados no StartFreela</h2>
                <span class="selo-info selo-info-verde">
                  <i class="fa-solid fa-check"></i> Auditado pelo sistema
                </span>
              </div>

              <p>
                Estes são os projetos que este usuário concluiu na plataforma.
                O histórico é gerado automaticamente e não pode ser editado,
                garantindo a credibilidade das avaliações.
              </p>
            </div>

            <div class="grid-historico">

              {{#each projetosConcluidos}}

                <article class="card-historico">
                  <div class="info-historico">
                    <h4>{{this.titulo}}</h4>

                    <div class="tags">
                      {{#each this.habilidades}}
                        <span class="tag">{{this}}</span>
                      {{/each}}
                    </div>

                    <p class="linha-meta">
                      Realizado para: <b>{{this.clienteUsername}}</b>
                    </p>

                    {{#if this.entrega.dataAprovacao}}
                      <p class="linha-meta">
                        Concluído em: {{this.entrega.dataAprovacao}}
                      </p>
                    {{/if}}
                  </div>

                  <div class="avaliacao-historico">
                    {{#if this.avaliacao}}
                      <p class="nota-historico">
                        <i class="fa-solid fa-star"></i>
                        {{this.avaliacao.nota}}/5
                      </p>

                      {{#if this.avaliacao.comentario}}
                        <p class="comentario-historico">
                          "{{this.avaliacao.comentario}}"
                        </p>
                      {{/if}}

                      <p class="selo-verificado">
                        <i class="fa-solid fa-check"></i>
                        Contrato Verificado
                      </p>
                    {{else}}
                      <p class="linha-meta">Ainda não avaliado</p>
                    {{/if}}
                  </div>
                </article>

              {{else}}
                <p class="linha-meta">Este freelancer ainda não concluiu trabalhos no StartFreela.</p>
              {{/each}}

            </div>
          </section>

        {{/if}}

        <!-- PROJETOS PUBLICADOS: SOMENTE CLIENTE -->
        {{#if ehCliente}}

          <section class="panel">
            <div class="header-secao">
              <div class="header-secao-titulo">
                <h2>Projetos Publicados</h2>
              </div>

              <p>Projetos publicados por este cliente na plataforma.</p>
            </div>

            <div class="grid-historico">

              {{#each projetosPublicados}}

                <article class="card-historico">
                  <div class="info-historico">

                    <div class="cpp-topo">
                      <h4>{{this.titulo}}</h4>

                      <span class="cpp-preco">
                        R$ {{this.orcamentoMinimo}} - R$ {{this.orcamentoMaximo}}
                      </span>
                    </div>

                    {{#if this.descricao}}
                      <p class="linha-meta">{{this.descricao}}</p>
                    {{/if}}

                    <div class="tags">
                      {{#each this.habilidades}}
                        <span class="tag">{{this}}</span>
                      {{/each}}
                    </div>

                    {{#if this.prazoDesejado}}
                      <p class="linha-meta">
                        <i class="fa-regular fa-calendar"></i>
                        Prazo: {{this.prazoDesejado}}
                      </p>
                    {{/if}}

                    {{#if this.categoria}}
                      <p class="linha-meta">
                        <i class="fa-solid fa-folder"></i>
                        Categoria: {{this.categoria}}
                      </p>
                    {{/if}}

                    {{#if this.dataPostagem}}
                      <p class="linha-meta">
                        <i class="fa-regular fa-clock"></i>
                        Publicado em: {{this.dataPostagem}}
                      </p>
                    {{/if}}

                    <p class="linha-meta">
                      <span class="selo-info">Projeto aberto</span>
                    </p>

                  </div>
                </article>

              {{else}}
                <p class="linha-meta">Este cliente ainda não possui projetos em aberto.</p>
              {{/each}}

            </div>
          </section>

        {{/if}}

        <!-- AVALIAÇÕES RECEBIDAS: AMBOS OS PERFIS -->
        <section class="panel">

          <div class="header-secao">

            {{#if ehCliente}}
              <h2>Avaliações dos Freelancers</h2>
              <p>
                Avaliações realizadas por freelancers que concluíram projetos com este cliente.
              </p>
            {{else}}
              <h2>Avaliações dos Clientes</h2>
              <p>
                Todas as avaliações abaixo vêm de contratos concluídos e verificados na plataforma.
              </p>
            {{/if}}

          </div>

          <!-- RESUMO DAS AVALIAÇÕES -->
          <div class="resumo-avaliacoes">

            <div class="nota-geral">
              <span class="nota-numero">{{mediaAvaliacoes}}</span>

              <div class="nota-estrelas">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </div>

              <span class="nota-total">
                {{totalAvaliacoes}} avaliações
              </span>
            </div>

            <div class="barras-avaliacao">

              {{#if ehCliente}}

                {{#each distribuicaoAvaliacoes}}
                  <div class="linha-barra">
                    <span>{{this.nota}}★</span>

                    <div class="barra">
                      <div class="barra-preenchida"
                        style="width: {{this.percentual}}%;">
                      </div>
                    </div>

                    <span class="barra-qtd">{{this.quantidade}}</span>
                  </div>
                {{/each}}

              {{else}}

                {{#each distribuicaoNotas}}
                  <div class="linha-barra">
                    <span>{{this.nota}}★</span>

                    <div class="barra">
                      <div class="barra-preenchida"
                        style="width: {{this.percentual}}%;">
                      </div>
                    </div>

                    <span class="barra-qtd">{{this.quantidade}}</span>
                  </div>
                {{/each}}

              {{/if}}

            </div>
          </div>

          <!-- LISTA DE AVALIAÇÕES -->
          <div class="lista-avaliacoes">

            {{#each avaliacoes}}

              <div class="avaliacao-item">

                <div class="avaliacao-item-topo">

                  <div class="avaliador">

                    <div class="avatar-round"></div>

                    <div>
                      <p class="avaliador-nome">
                        {{this.avaliadorUsername}}
                      </p>

                      <p class="avaliador-projeto">
                        {{this.tituloProjeto}}
                      </p>

                      <p class="avaliador-projeto">
                        {{this.dataFormatada}}
                      </p>
                    </div>

                  </div>

                  <span class="nota-item">
                    <i class="fa-solid fa-star"></i>
                    {{this.nota}}/5
                  </span>

                </div>

                <p class="avaliacao-texto">

                  {{#if this.comentario}}
                    "{{this.comentario}}"
                  {{else}}

                    {{#if ../ehCliente}}
                      Freelancer não deixou comentário.
                    {{else}}
                      Cliente não deixou comentário.
                    {{/if}}

                  {{/if}}

                </p>

              </div>

            {{else}}
              <p class="linha-meta">Ainda não existem avaliações.</p>
            {{/each}}

          </div>

        </section>

      </div>

      <!-- COLUNA LATERAL -->
      <aside class="col-side">

        <!-- ESTATÍSTICAS -->
        <section class="panel">
          <h2>Estatísticas</h2>

          {{#if ehCliente}}

            <p class="linha-stat">
              Projetos Publicados
              <span class="stat-valor">
                {{totalProjetos}}
                <i class="fa-solid fa-folder-open"></i>
              </span>
            </p>

            <p class="linha-stat">
              Projetos em Aberto
              <span class="stat-valor">
                {{totalProjetosAbertos}}
                <i class="fa-solid fa-clock"></i>
              </span>
            </p>

            <p class="linha-stat">
              Projetos Concluídos
              <span class="stat-valor stat-verde">
                {{totalConcluidos}}
                <i class="fa-solid fa-check"></i>
              </span>
            </p>

            <p class="linha-stat">
              Avaliação Média
              <span class="stat-valor stat-dourado">
                {{mediaAvaliacoes}}
                <i class="fa-solid fa-star"></i>
              </span>
            </p>

            <p class="linha-stat">
              Avaliações Recebidas
              <span class="stat-valor">
                {{totalAvaliacoes}}
              </span>
            </p>

          {{else}}

            <p class="linha-stat">
              Projetos Concluídos
              <span class="stat-valor stat-verde">
                {{totalProjetos}}
                <i class="fa-solid fa-check"></i>
              </span>
            </p>

            <p class="linha-stat">
              Avaliação Média
              <span class="stat-valor stat-dourado">
                {{mediaAvaliacoes}}
                <i class="fa-solid fa-star"></i>
              </span>
            </p>

            <p class="linha-stat">
              Avaliações Recebidas
              <span class="stat-valor">
                {{totalAvaliacoes}}
              </span>
            </p>

          {{/if}}

          <p class="linha-stat sem-borda">
            Membro desde <b>{{perfil.createdIn}}</b>
          </p>

        </section>

      </aside>

    </div>

  </main>

  <script src="/js.components/header-dropdown.js"></script>
  <script type="module" src="/js/technical_profile.js"></script>
  <script src="/assets/js/utils/desativar-autocomplete.js"></script>

</body>

</html>

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StartFreela - Início</title>
    <link rel="stylesheet" href="/css/tela-inicial.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>
    <header class="topbar">
        <div class="logo">
            <img id="logo-image" src="/img/logo-deitada.png" alt="StartFreela">
        </div>

        <div class="search-wrap">
            <i id="icon" class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="search" id="search" placeholder="Busque em StartFreela...">
        </div>

        <div class="top-actions">
            <a class="icon-btn" href="/notifications"><i class="fa-solid fa-bell"></i><span class="badge">1</span></a>
            <a class="icon-btn" href="/messages"><i class="fa-solid fa-comment-dots"></i><span class="badge">1</span></a>
            <span class="role-pill">{{usuario.role}}</span>
            <div class="avatar-wrap">
            <div class="avatar"><img id="foto-de-perfil" src="/img/foto-do-perfil.png" alt=""></div>
            <i class="fa-solid fa-chevron-down chev"></i>

            <div class="avatar-dropdown">
                <div class="dropdown-header">
                <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
                <span>{{usuario.completeName}}</span>
                </div>
                <a href="/profile"><i class="fa-solid fa-user"></i> Ver perfil</a>
                <a href="#"><i class="fa-solid fa-briefcase"></i> Meu Portfólio</a>
                <a href="#"><i class="fa-solid fa-file-lines"></i> Serviços e Propostas</a>
                <a href="/settings"><i class="fa-solid fa-gear"></i> Configurações da Conta</a>
                <a href="#" class="dropdown-sair" id="sair" ><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
            </div>
            </div>
        </div>
    </header>

    <nav class="subnav">
        <a href="/home" class="active">Tela Inicial</a>
        <a href="/freelancers">Freelancers</a>
        <a href="/projects">Projetos</a>
        <a href="/support">Suporte</a>
    </nav>

    <main class="main">
        <section class="hero">
            <div class="hero-content">
                <h1>Transforme suas ideias<br><span>em grandes projetos</span></h1>
                <p>Conecte-se com os melhores freelancers e encontre os projetos ideais para o seu talento.</p>

                <div class="main-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="projectSearch" placeholder="O que você precisa?">
                    <button id="searchButton">Buscar</button>
                </div>

                <div class="suggestions">
                    <button>Web Design</button>
                    <button>Desenvolvimento</button>
                    <button>Design Gráfico</button>
                    <button>Marketing</button>
                    <button>Redação</button>
                </div>
            </div>

            <div class="hero-illustration">
                <div class="lightbulb">💡</div>
                <div class="code-box">&lt;/&gt;</div>
                <div class="plant">🌱</div>
                <div class="person">
                    <div class="head">👨🏻‍💻</div>
                    <div class="body">💻</div>
                </div>
            </div>
        </section>

        <section class="publish-card">
            <div class="publish-icon">📣</div>
            <div class="publish-text">
                <h2>Está procurando um freelancer?</h2>
                <p>Publique seu projeto e receba propostas de profissionais qualificados.</p>
            </div>
            <button class="publish-button" id="publishButton"><i class="fa-solid fa-plus"></i>Publicar projeto</button>
        </section>

        <section class="categories">
            <div class="category">
                <div class="category-icon"><i class="fa-solid fa-code"></i></div>
                <h3>Desenvolvimento</h3>
                <span>1200+</span>
            </div>

            <div class="category">
                <div class="category-icon"><i class="fa-solid fa-palette"></i></div>
                <h3>Design</h3>
                <span>980+</span>
            </div>

            <div class="category">
                <div class="category-icon"><i class="fa-solid fa-bullhorn"></i></div>
                <h3>Marketing</h3>
                <span>760+</span>
            </div>

            <div class="category">
                <div class="category-icon"><i class="fa-solid fa-pen"></i></div>
                <h3>Redação</h3>
                <span>540+</span>
            </div>

            <div class="category">
                <div class="category-icon"><i class="fa-solid fa-desktop"></i></div>
                <h3>TI & Suporte</h3>
                <span>430+</span>
            </div>

            <div class="category">
                <div class="category-icon"><i class="fa-solid fa-camera"></i></div>
                <h3>Audiovisual</h3>
                <span>320+</span>
            </div>

            <div class="category">
                <div class="category-icon"><i class="fa-solid fa-chart-line"></i></div>
                <h3>Outros</h3>
                <span>210+</span>
            </div>
        </section>

        <div class="content-grid">
            <section class="projects-section">
                <div class="section-header">
                    <div>
                        <h2>Projetos em destaque</h2>
                        <div class="yellow-line"></div>
                    </div>
                    <a href="#">Ver todos os projetos<i class="fa-solid fa-arrow-right"></i></a>
                </div>

                <div class="projects" id="projects">
                    <article class="project-card" data-category="desenvolvimento">
                        <div class="project-image">
                            <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=600" alt="Projeto web">
                            <span class="featured">Destaque</span>
                            <button class="favorite">♡</button>
                        </div>

                        <div class="project-content">
                            <h3>Site institucional moderno</h3>
                            <p>Preciso de um site institucional responsivo para minha empresa.</p>

                            <div class="project-info">
                                <span><i class="fa-solid fa-coins"></i>R$ 800 - 1.500</span>
                                <span><i class="fa-regular fa-calendar"></i>7 dias</span>
                            </div>

                            <div class="tags">
                                <span>HTML</span>
                                <span>CSS</span>
                                <span>JavaScript</span>
                            </div>
                        </div>
                    </article>

                    <article class="project-card" data-category="design">
                        <div class="project-image">
                            <img src="https://images.unsplash.com/photo-1561070791-2526d30994b5?w=600" alt="Design">
                            <button class="favorite">♡</button>
                        </div>

                        <div class="project-content">
                            <h3>Criação de logo profissional</h3>
                            <p>Quero um logo moderno e minimalista para minha marca.</p>

                            <div class="project-info">
                                <span><i class="fa-solid fa-coins"></i>R$ 150 - 400</span>
                                <span><i class="fa-regular fa-calendar"></i>5 dias</span>
                            </div>

                            <div class="tags">
                                <span>Design Gráfico</span>
                                <span>Branding</span>
                            </div>
                        </div>
                    </article>

                    <article class="project-card" data-category="desenvolvimento">
                        <div class="project-image">
                            <img src="https://images.unsplash.com/photo-1551650975-87deedd944c3?w=600" alt="Aplicativo">
                            <button class="favorite">♡</button>
                        </div>

                        <div class="project-content">
                            <h3>App de controle financeiro</h3>
                            <p>Preciso de um aplicativo simples para controle financeiro.</p>

                            <div class="project-info">
                                <span><i class="fa-solid fa-coins"></i>R$ 1.000 - 2.500</span>
                                <span><i class="fa-regular fa-calendar"></i>15 dias</span>
                            </div>

                            <div class="tags">
                                <span>React Native</span>
                                <span>Firebase</span>
                            </div>
                        </div>
                    </article>

                    <article class="project-card" data-category="redacao">
                        <div class="project-image">
                            <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=600" alt="Redação">
                            <button class="favorite">♡</button>
                        </div>

                        <div class="project-content">
                            <h3>Artigos para blog</h3>
                            <p>Procuro um redator para criar 10 artigos sobre tecnologia.</p>
                            <div class="project-info">
                                <span><i class="fa-solid fa-coins"></i>R$ 50 - 100</span>
                                <span><i class="fa-regular fa-calendar"></i>3 dias</span>
                            </div>

                            <div class="tags">
                                <span>Redação</span>
                                <span>SEO</span>
                            </div>
                        </div>
                    </article>
                </div>
            </section>

            <aside class="right-sidebar">
                <section class="side-card">
                    <div class="side-title">
                        <h2>Freelancers em destaque</h2>
                        <div class="yellow-line"></div> 
                    </div>

                    <div class="freelancer-list">
                        <div class="freelancer">
                            <img src="https://i.pravatar.cc/100?img=11" alt="">
                            <div class="freelancer-info">
                                <strong>Lucas Ferreira</strong>
                                <span>Desenvolvedor Full Stack</span>
                                <small>⭐ 4.9 (124) &nbsp; • &nbsp; R$ 50/h</small>
                            </div>
                            <i class="fa-solid fa-chevron-right"></i>
                        </div>

                        <div class="freelancer">
                            <img src="https://i.pravatar.cc/100?img=47" alt="">
                            <div class="freelancer-info">
                                <strong>Mariana Costa</strong>
                                <span>Designer Gráfico</span>
                                <small>⭐ 4.8 (98) &nbsp; • &nbsp; R$ 45/h</small>
                            </div>
                            <i class="fa-solid fa-chevron-right"></i>
                        </div>

                        <div class="freelancer">
                            <img src="https://i.pravatar.cc/100?img=12" alt="">
                            <div class="freelancer-info">
                                <strong>Rafael Santos</strong>
                                <span>Desenvolvedor Frontend</span>
                                <small>⭐ 4.7 (76) &nbsp; • &nbsp; R$ 40/h</small>
                            </div>
                            <i class="fa-solid fa-chevron-right"></i>
                        </div>

                        <div class="freelancer">
                            <img src="https://i.pravatar.cc/100?img=44" alt="">
                            <div class="freelancer-info">
                                <strong>Juliana Alves</strong>
                                <span>Redatora</span>
                                <small>⭐ 4.9 (112) &nbsp; • &nbsp; R$ 35/h</small>
                            </div>
                            <i class="fa-solid fa-chevron-right"></i>
                        </div>
                    </div>
                </section>

                <section class="side-card recent">
                    <div class="side-title">
                        <h2>Projetos recentes</h2>
                        <div class="yellow-line"></div>
                    </div>

                    <div class="recent-project">
                        <i class="fa-regular fa-folder"></i>
                        <span>Desenvolver landing page</span>
                        <small>há 2 horas</small>
                    </div>

                    <div class="recent-project">
                        <i class="fa-regular fa-folder"></i>
                        <span>Editar vídeo promocional</span>
                        <small>há 4 horas</small>
                    </div>

                    <div class="recent-project">
                        <i class="fa-regular fa-folder"></i>
                        <span>Criar identidade visual</span>
                        <small>há 6 horas</small>
                    </div>

                    <div class="recent-project">
                        <i class="fa-regular fa-folder"></i>
                        <span>Correção de bugs no sistema</span>
                        <small>há 8 horas</small>
                    </div>
                </section>
            </aside>
        </div>
    </main>

    <script type="module" src="/js/home.js"></script>
    <script src="/js.components/header-dropdown.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StartFreela - Meu Perfil</title>

<link rel="stylesheet" href="/css/tela-perfil-cliente.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer">

<script defer>
window.dadosPagina = {
    usuario: {{{json usuario}}}
};
</script>
</head>

<body>

<header class="topbar">
    <div class="logo">
        <img id="logo-image" src="/img/logo-deitada.png" alt="StartFreela">
    </div>

    <div class="search-wrap">
        <i id="icon" class="fa-solid fa-magnifying-glass"></i>
        <input type="text" name="search" id="search" placeholder="Busque em StartFreela...">
    </div>

    <div class="top-actions">
        <div class="icon-btn">
            <i class="fa-solid fa-bell"></i>
            <span class="badge">1</span>
        </div>

        <a class="icon-btn" href="/messages">
            <i class="fa-solid fa-comment-dots"></i>
            <span class="badge">1</span>
        </a>

        <span class="role-pill">{{usuario.role}}</span>

        <div class="avatar-wrap">
            <div class="avatar">
                <img src="/img/foto-do-perfil.png" alt="">
            </div>

            <i class="fa-solid fa-chevron-down chev"></i>

            <div class="avatar-dropdown">
                <div class="dropdown-header">
                    <div class="avatar">
                        <img src="/img/foto-do-perfil.png" alt="">
                    </div>
                    <span>{{usuario.completeName}}</span>
                </div>

                <a href="/profile">
                    <i class="fa-solid fa-user"></i> Ver perfil público
                </a>

                <a href="/settings">
                    <i class="fa-solid fa-gear"></i> Configurações
                </a>

                <a href="#" class="dropdown-sair" id="sair">
                    <i class="fa-solid fa-right-from-bracket"></i> Sair
                </a>
            </div>
        </div>
    </div>
</header>

<nav class="subnav">
    <a href="/home">Tela Inicial</a>
    <a href="/freelancers">Freelancers</a>
    <a href="/projects">Projetos</a>
    <a href="/support">Suporte</a>
</nav>

<main>
    <h1 class="page-title">Meu Perfil</h1>

    <div class="layout">

        <!-- COLUNA PRINCIPAL -->
        <div class="col-main">

            <!-- DADOS DO PERFIL -->
            <section class="panel">
                <h2>Meu Perfil</h2>

                <div class="perfil-topo">

                    <div class="avatar-grande">
                        <img src="/img/icone-user.png" alt="Foto de perfil">
                    </div>

                    <div class="perfil-dados">

                        <div class="perfil-nome-row">
                            <h3>{{usuario.completeName}}</h3>
                        </div>

                        <p class="nome-usuario">@{{usuario.username}}</p>

                        {{#if usuario.profissao}}
                            <p class="profissao">{{usuario.profissao}}</p>
                        {{else}}
                            <p class="profissao">--------//--------</p>
                        {{/if}}

                        <div class="perfil-meta">

                            {{#if usuario.localizacao.cidade}}
                                <span class="meta-item">
                                    <i class="fa-solid fa-location-dot"></i>
                                    {{usuario.localizacao.cidade}}, {{usuario.localizacao.estado}}
                                </span>
                            {{else}}
                                <span class="meta-item">
                                    <i class="fa-solid fa-location-dot"></i>
                                    ----//----
                                </span>
                            {{/if}}

                            {{#if usuario.ativo}}
                                <span class="meta-item status-disponivel">
                                    <i class="fa-solid fa-circle"></i>
                                    Ativo
                                </span>
                            {{else}}
                                <span class="meta-item status-indisponivel">
                                    <i class="fa-solid fa-circle"></i>
                                    Inativo
                                </span>
                            {{/if}}

                        </div>

                        <div class="perfil-links">
                            {{#each usuario.redesSociais}}
                                <a href="{{this.link}}" target="_blank" rel="noopener noreferrer" title="{{this.site}}">
                                    {{this.site}}
                                </a>
                            {{/each}}
                        </div>

                    </div>

                    {{#if usuario.informacoesAdicionais}}
    <button class="btn-primary btn-editar" id="btn-editProfile">
        <i class="fa-solid fa-pen"></i> Editar Perfil
    </button>
{{else}}
    <a class="btn-primary btn-editar" id="btn-addInfo" href="/additional.information">
        <i class="fa-solid fa-plus"></i> Informações Adicionais
    </a>
{{/if}}

                </div>

                <div class="divisor"></div>

                <!-- SOBRE MIM -->
                <div class="bloco">
                    <h3 class="titulo-bloco">Sobre Mim</h3>

                    {{#if usuario.sobreMim}}
                        <p class="texto-sobre">{{usuario.sobreMim}}</p>
                    {{else}}
                        <p class="texto-sobre">Nenhuma descrição adicionada.</p>
                    {{/if}}
                </div>

                <!-- HABILIDADES -->
                <div class="bloco">
                    <h3 class="titulo-bloco">Habilidades Técnicas</h3>

                    <div class="chips">
                        {{#each usuario.habilidades}}
                            <span class="chip">{{this}}</span>
                        {{else}}
                            <p class="linha-meta">Nenhuma habilidade adicionada.</p>
                        {{/each}}
                    </div>
                </div>

            </section>

            <!-- PROJETOS PUBLICADOS -->
            <section class="panel">
                <div class="header-secao">

                    <div class="header-secao-titulo">
                        <h2>Projetos Publicados</h2>
                        <span class="selo-info">{{totalProjetosAbertos}} em aberto</span>
                    </div>

                    <p>Projetos que este cliente tem disponíveis na plataforma no momento.</p>

                </div>

                <div class="grid-projetos-publicados">

                    {{#each projetosPublicados}}
                        <div class="card-projeto-pub">

                            <div class="cpp-corpo">

                                <div class="cpp-topo">
                                    <h4>{{this.titulo}}</h4>

                                    <span class="cpp-preco">
                                        R$ {{this.orcamentoMinimo}} - R$ {{this.orcamentoMaximo}}
                                    </span>
                                </div>

                                <div class="tags">
                                    {{#each this.habilidades}}
                                        <span class="tag">{{this}}</span>
                                    {{/each}}
                                </div>

                                <p class="cpp-meta">
                                    <i class="fa-solid fa-clock"></i>
                                    Prazo: {{this.prazoDesejado}}
                                </p>

                                <p class="cpp-meta">
                                    <i class="fa-solid fa-folder"></i>
                                    Categoria: {{this.categoria}}
                                </p>

                                <p class="cpp-meta">
                                    <i class="fa-solid fa-calendar"></i>
                                    Publicado em: {{this.dataPostagem}}
                                </p>

                            </div>

                        </div>
                    {{else}}
                        <p>Nenhum projeto em aberto no momento.</p>
                    {{/each}}

                </div>
            </section>

            <!-- HISTÓRICO DE CONTRATAÇÕES -->
            <section class="panel">

                <div class="header-secao">

                    <div class="header-secao-titulo">
                        <h2>Histórico de Contratações</h2>

                        <span class="selo-info selo-info-verde">
                            <i class="fa-solid fa-check"></i>
                            Projetos concluídos
                        </span>
                    </div>

                    <p>Projetos concluídos por este cliente na plataforma.</p>

                </div>

                <div class="grid-historico">

                    {{#each historicoProjetos}}
                        <article class="card-historico">

                            <div class="info-historico">

                                <h4>{{this.titulo}}</h4>

                                <div class="tags">
                                    {{#each this.habilidades}}
                                        <span class="tag">{{this}}</span>
                                    {{/each}}
                                </div>

                                <p class="linha-meta">
                                    Contratado:

                                    <b>
                                        {{#if this.freelancerUsernameContratado}}
                                            {{this.freelancerUsernameContratado}}
                                        {{else}}
                                            Não informado
                                        {{/if}}
                                    </b>
                                </p>

                                <p class="linha-meta">
                                    Concluído em:

                                    {{#if this.entrega.dataAprovacao}}
                                        {{this.entrega.dataAprovacao}}
                                    {{else}}
                                        Data não disponível
                                    {{/if}}
                                </p>

                            </div>

                            <div class="avaliacao-historico">

                                {{#if this.avaliacao}}

                                    <p class="nota-historico">
                                        <i class="fa-solid fa-star"></i>
                                        {{this.avaliacao.nota}}
                                    </p>

                                    <p class="comentario-historico">
                                        {{#if this.avaliacao.comentario}}
                                            "{{this.avaliacao.comentario}}"
                                        {{else}}
                                            Avaliação sem comentário.
                                        {{/if}}
                                    </p>

                                {{else}}

                                    <p class="comentario-historico">
                                        Este projeto ainda não possui avaliação.
                                    </p>

                                {{/if}}

                                <p class="selo-verificado">
                                    <i class="fa-solid fa-check"></i>
                                    Projeto concluído
                                </p>

                            </div>

                        </article>

                    {{else}}
                        <p>Este cliente ainda não possui projetos concluídos.</p>
                    {{/each}}

                </div>

            </section>

            <!-- AVALIAÇÕES RECEBIDAS -->
            <section class="panel">

                <div class="header-secao">
                    <h2>Avaliações Recebidas</h2>
                    <p>Avaliações feitas pelos freelancers que já trabalharam com este cliente.</p>
                </div>

                <div class="resumo-avaliacoes">

                    <div class="nota-geral">

                        <span class="nota-numero">{{mediaAvaliacoes}}</span>

                        <span class="nota-estrelas">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                        </span>

                        <span class="nota-total">
                            {{totalAvaliacoes}} avaliações
                        </span>

                    </div>

                    <div class="barras-avaliacao">

                        {{#each distribuicaoAvaliacoes}}
                            <div class="linha-barra">

                                <span>{{this.nota}}★</span>

                                <div class="barra">
                                    <div class="barra-preenchida" style="width: {{this.percentual}}%;"></div>
                                </div>

                                <span class="barra-qtd">{{this.quantidade}}</span>

                            </div>
                        {{/each}}

                    </div>

                </div>

                <div class="lista-avaliacoes">

                    {{#each avaliacoes}}
                        <div class="avaliacao-item">

                            <div class="avaliacao-item-topo">

                                <div class="avaliador">

                                    <div class="avatar-round">
                                        <i class="fa-solid fa-user"></i>
                                    </div>

                                    <div>

                                        <p class="avaliador-nome">
                                            {{this.avaliadorUsername}}
                                        </p>

                                        <p class="avaliador-projeto">
                                            {{this.tituloProjeto}}
                                        </p>

                                    </div>

                                </div>

                                <span class="nota-item">
                                    <i class="fa-solid fa-star"></i>
                                    {{this.nota}}
                                </span>

                            </div>

                            <p class="avaliacao-texto">
                                {{#if this.comentario}}
                                    "{{this.comentario}}"
                                {{else}}
                                    Avaliação sem comentário.
                                {{/if}}
                            </p>

                        </div>

                    {{else}}
                        <p>Este cliente ainda não recebeu avaliações.</p>
                    {{/each}}

                </div>

            </section>

        </div>

        <!-- COLUNA LATERAL -->
        <aside class="col-side">

            <!-- ESTATÍSTICAS -->
            <section class="panel">

                <h2>Estatísticas do Cliente</h2>

                <p class="linha-stat">
                    Projetos Publicados
                    <span class="stat-valor">{{totalProjetos}}</span>
                </p>

                <p class="linha-stat">
                    Projetos em Aberto
                    <span class="stat-valor">{{totalProjetosAbertos}}</span>
                </p>

                <p class="linha-stat">
                    Contratos Concluídos

                    <span class="stat-valor stat-verde">
                        {{totalConcluidos}}
                        <i class="fa-solid fa-check"></i>
                    </span>
                </p>

                <p class="linha-stat">
                    Avaliações Recebidas
                    <span class="stat-valor">{{totalAvaliacoes}}</span>
                </p>

                <p class="linha-stat">
                    Avaliação Média

                    <span class="stat-valor stat-dourado">
                        {{mediaAvaliacoes}}
                        <i class="fa-solid fa-star"></i>
                    </span>
                </p>

                <p class="linha-stat sem-borda">
                    Membro desde
                    <b>{{usuario.createdIn}}</b>
                </p>

            </section>

            <!-- SELOS DE CONFIANÇA -->
            <section class="panel">

                <h2>Selos de Confiança</h2>

                <div class="lista-selos">
                    <p>Nenhum selo de confiança disponível no momento.</p>
                </div>

            </section>

        </aside>

    </div>
</main>

<script src="/js.components/header-dropdown.js"></script>
<script type="module" src="/js/profile.js"></script>
<script src="/js/utils/desativar-autocomplete.js"></script>

</body>
</html>

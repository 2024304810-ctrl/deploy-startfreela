<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StartFreela - Meu Perfil</title>
<link rel="stylesheet" href="/css/tela-perfil-cliente.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<script defer>
  window.dadosPagina = {
    usuario: {{{json usuario}}},
  }
</script>
</head>
<body>

<header class="topbar">
  <div class="logo">
    <img id="logo-image" src="/img/logo-deitada.png" alt="StartFreela">
  </div>

  <div class="search-wrap">
    <i id="icon" class="fa-solid fa-magnifying-glass"></i>
    <input type="text" name="search" id="search" placeholder="Busque em StartFreela...">
  </div>

  <div class="top-actions">
    <div class="icon-btn"><i class="fa-solid fa-bell"></i><span class="badge">1</span></div>
    <a class="icon-btn" href="/messages"><i class="fa-solid fa-comment-dots"></i><span class="badge">1</span></a>
    <span class="role-pill">{{usuario.role}}</span>
    <div class="avatar-wrap">
      <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
      <i class="fa-solid fa-chevron-down chev"></i>

      <div class="avatar-dropdown">
        <div class="dropdown-header">
          <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
          <span>{{usuario.completeName}}</span>
        </div>
        <a href="/profile"><i class="fa-solid fa-user"></i> Ver perfil público</a>
        <a href="#"><i class="fa-solid fa-briefcase"></i> Meus Projetos</a>
        <a href="#"><i class="fa-solid fa-file-lines"></i> Propostas Recebidas</a>
        <a href="#"><i class="fa-solid fa-gear"></i> Configurações da Conta</a>
        <a href="#" class="dropdown-sair" id="sair"><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
      </div>
    </div>
  </div>
</header>

<nav class="subnav">
  <a href="/home">Tela Inicial</a>
  <a href="/freelancers">Freelancers</a>
  <a href="/projects">Projetos</a>
  <a href="/support">Suporte</a>
</nav>

<main>
  <h1 class="page-title">Meu Perfil</h1>

  <div class="layout">

    <!-- COLUNA PRINCIPAL -->
    <div class="col-main">

      <!-- Dados do perfil -->
      <section class="panel">
        <h2>Meu Perfil</h2>

        <div class="perfil-topo">
          <div class="avatar-grande">
            <img src="/img/icone-user.png" alt="Foto de perfil">
          </div>
          <div class="perfil-dados">
            <div class="perfil-nome-row">
              <h3>{{usuario.completeName}}</h3>
              <span class="selo-verificado-mini" title="Identidade verificada"><i class="fa-solid fa-shield-halved"></i> Verificado</span>
            </div>
            <p class="nome-usuario">@{{usuario.username}}</p>

            <div class="perfil-meta">
              <span class="meta-item"><i class="fa-solid fa-location-dot"></i> Manaus, AM</span>
              <span class="meta-item status-disponivel"><i class="fa-solid fa-circle"></i> Online</span>
            </div>
          </div>

          <button class="btn-primary btn-editar"><i class="fa-solid fa-pen"></i> Editar Perfil</button>
        </div>

        <div class="divisor"></div>

        <div class="bloco">
          <h3 class="titulo-bloco">Sobre</h3>
          <p class="texto-sobre">Empreendedora na área de saúde estética, costumo contratar freelancers para desenvolvimento de sites institucionais, landing pages e pequenas automações. Valorizo comunicação clara e prazos bem definidos.</p>
        </div>
      </section>

      <!-- Projetos publicados (ativos) -->
      <section class="panel">
        <div class="header-secao">
          <div class="header-secao-titulo">
            <h2>Projetos Publicados</h2>
            <span class="selo-info">2 em aberto</span>
          </div>
          <p>Projetos que este cliente tem disponíveis na plataforma no momento.</p>
        </div>

      
        <div class="grid-projetos-publicados">
          <div class="card-projeto-pub">
            <img src="/img/gato.jpg" alt="Site Institucional para Clínica">
            <div class="cpp-corpo">
              <div class="cpp-topo">
                <h4>Site Institucional para Clínica</h4>
                <span class="cpp-preco">R$ 450,00</span>
              </div>
              <div class="tags">
                <span class="tag">HTML5</span>
                <span class="tag">CSS3</span>
              </div>
              <p class="cpp-meta"><i class="fa-solid fa-clock"></i> Restam 4 dias &nbsp;·&nbsp; 3 propostas recebidas</p>
            </div>
          </div>

          <div class="card-projeto-pub">
            <img src="/img/gato.jpg" alt="Automação de Agendamento via WhatsApp">
            <div class="cpp-corpo">
              <div class="cpp-topo">
                <h4>Automação de Agendamento via WhatsApp</h4>
                <span class="cpp-preco">R$ 600,00</span>
              </div>
              <div class="tags">
                <span class="tag">Node.js</span>
                <span class="tag">API</span>
              </div>
              <p class="cpp-meta"><i class="fa-solid fa-clock"></i> Restam 9 dias &nbsp;·&nbsp; 1 proposta recebida</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Histórico de contratações -->
      <section class="panel">
        <div class="header-secao">
          <div class="header-secao-titulo">
            <h2>Histórico de Contratações</h2>
            <span class="selo-info selo-info-verde"><i class="fa-solid fa-check"></i> Auditado pelo sistema</span>
          </div>
          <p>Projetos concluídos por este cliente na plataforma. O histórico é gerado automaticamente e não editável, garantindo a credibilidade das informações.</p>
        </div>

        <div class="grid-historico">
          <article class="card-historico">
            <img class="img-historico" src="/img/gato.jpg" alt="">
            <div class="info-historico">
              <h4>Landing Page para Evento</h4>
              <div class="tags">
                <span class="tag">JavaScript</span>
                <span class="tag">React</span>
              </div>
              <p class="linha-meta">Contratado: <b>Marina Costa</b></p>
              <p class="linha-meta">Concluído em: Maio/2026</p>
            </div>
            <div class="avaliacao-historico">
              <p class="nota-historico"><i class="fa-solid fa-star"></i> 5.0</p>
              <p class="comentario-historico">"Cliente muito claro no briefing e pagamento pontual."</p>
              <p class="selo-verificado"><i class="fa-solid fa-check"></i> Contrato Verificado</p>
            </div>
          </article>

          <article class="card-historico">
            <img class="img-historico" src="/img/gato.jpg" alt="">
            <div class="info-historico">
              <h4>Cardápio Digital para Restaurante</h4>
              <div class="tags">
                <span class="tag">PHP</span>
                <span class="tag">MySQL</span>
              </div>
              <p class="linha-meta">Contratado: <b>Lucas Ferreira</b></p>
              <p class="linha-meta">Concluído em: Março/2026</p>
            </div>
            <div class="avaliacao-historico">
              <p class="nota-historico"><i class="fa-solid fa-star"></i> 4.8</p>
              <p class="comentario-historico">"Boa comunicação durante todo o projeto."</p>
              <p class="selo-verificado"><i class="fa-solid fa-check"></i> Contrato Verificado</p>
            </div>
          </article>
        </div>
      </section>

      <!-- Avaliações recebidas -->
      <section class="panel">
        <div class="header-secao">
          <h2>Avaliações Recebidas</h2>
          <p>Avaliações feitas pelos freelancers que já trabalharam com este cliente.</p>
        </div>

        <div class="resumo-avaliacoes">
          <div class="nota-geral">
            <span class="nota-numero">4.9</span>
            <span class="nota-estrelas"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></span>
            <span class="nota-total">8 avaliações</span>
          </div>

          <div class="barras-avaliacao">
            <div class="linha-barra">
              <span>5★</span>
              <div class="barra"><div class="barra-preenchida" style="width: 88%;"></div></div>
              <span class="barra-qtd">7</span>
            </div>
            <div class="linha-barra">
              <span>4★</span>
              <div class="barra"><div class="barra-preenchida" style="width: 12%;"></div></div>
              <span class="barra-qtd">1</span>
            </div>
            <div class="linha-barra">
              <span>3★</span>
              <div class="barra"><div class="barra-preenchida" style="width: 0%;"></div></div>
              <span class="barra-qtd">0</span>
            </div>
            <div class="linha-barra">
              <span>2★</span>
              <div class="barra"><div class="barra-preenchida" style="width: 0%;"></div></div>
              <span class="barra-qtd">0</span>
            </div>
            <div class="linha-barra">
              <span>1★</span>
              <div class="barra"><div class="barra-preenchida" style="width: 0%;"></div></div>
              <span class="barra-qtd">0</span>
            </div>
          </div>
        </div>

        <div class="lista-avaliacoes">
          <div class="avaliacao-item">
            <div class="avaliacao-item-topo">
              <div class="avaliador">
                <div class="avatar-round">M</div>
                <div>
                  <p class="avaliador-nome">Marina Costa</p>
                  <p class="avaliador-projeto">Landing Page para Evento</p>
                </div>
              </div>
              <span class="nota-item"><i class="fa-solid fa-star"></i> 5.0</span>
            </div>
            <p class="avaliacao-texto">"Cliente muito claro no briefing e pagamento pontual, recomendo!"</p>
          </div>

          <div class="avaliacao-item">
            <div class="avaliacao-item-topo">
              <div class="avaliador">
                <div class="avatar-round">L</div>
                <div>
                  <p class="avaliador-nome">Lucas Ferreira</p>
                  <p class="avaliador-projeto">Cardápio Digital para Restaurante</p>
                </div>
              </div>
              <span class="nota-item"><i class="fa-solid fa-star"></i> 4.8</span>
            </div>
            <p class="avaliacao-texto">"Boa comunicação durante todo o projeto."</p>
          </div>
        </div>
      </section>

    </div>

    <!-- COLUNA LATERAL -->
    <aside class="col-side">

      <section class="panel">
        <h2>Estatísticas de Confiança</h2>
        <p class="linha-stat">Projetos Publicados <span class="stat-valor">12</span></p>
        <p class="linha-stat">Contratos Concluídos <span class="stat-valor stat-verde">9 <i class="fa-solid fa-check"></i></span></p>
        <p class="linha-stat">Pagamento em Dia <span class="stat-valor stat-verde">100%</span></p>
        <p class="linha-stat">Taxa de Resposta <span class="stat-valor">95%</span></p>
        <p class="linha-stat">Taxa de Cancelamento <span class="stat-valor stat-verde">2%</span></p>
        <p class="linha-stat">Avaliação Média <span class="stat-valor stat-dourado">4.9 <i class="fa-solid fa-star"></i></span></p>
        <p class="linha-stat sem-borda">Membro desde <b>{{usuario.createdIn}}</b></p>
      </section>

      <section class="panel">
        <h2>Selos de Confiança</h2>
        <div class="lista-selos">
          <div class="selo-item">
            <i class="fa-solid fa-shield-halved"></i>
            <div>
              <p class="selo-titulo">Identidade Verificada</p>
              <p class="selo-desc">Documento validado pela equipe StartFreela</p>
            </div>
          </div>
          <div class="selo-item">
            <i class="fa-solid fa-credit-card"></i>
            <div>
              <p class="selo-titulo">Forma de Pagamento Verificada</p>
              <p class="selo-desc">Cartão ou PIX confirmado pela plataforma</p>
            </div>
          </div>
          <div class="selo-item">
            <i class="fa-solid fa-money-check-dollar"></i>
            <div>
              <p class="selo-titulo">Pagador Pontual</p>
              <p class="selo-desc">100% dos contratos pagos dentro do prazo</p>
            </div>
          </div>
          <div class="selo-item">
            <i class="fa-solid fa-bolt"></i>
            <div>
              <p class="selo-titulo">Resposta Rápida</p>
              <p class="selo-desc">Responde propostas em menos de 2h</p>
            </div>
          </div>
          <div class="selo-item">
            <i class="fa-solid fa-repeat"></i>
            <div>
              <p class="selo-titulo">Cliente Frequente</p>
              <p class="selo-desc">Mais de 5 contratos concluídos na plataforma</p>
            </div>
          </div>
        </div>
      </section>

    </aside>
  </div>
</main>

<script src="/js.components/header-dropdown.js"></script>
<script type="module" src="/js/profile.js"></script>
</body>
</html>

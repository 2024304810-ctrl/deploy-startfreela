<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StartFreela - Suporte</title>
<link rel="stylesheet" href="/css/tela-suporte.css">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>

<header class="topbar">
  <a href="/home" class="logo">
      <img id="logo-image" src="/img/logo-deitada.png" alt="StartFreela">
  </a>

  <div class="search-wrap">
    <i id="icon" class="fa-solid fa-magnifying-glass"></i>
    <input type="text" name="search" id="search" placeholder="Busque em StartFreela...">
  </div>

  <div class="top-actions">
    <a class="icon-btn" href="/notifications"><i class="fa-solid fa-bell"></i><span class="badge">1</span></a>
    <a class="icon-btn" href="/messages"><i class="fa-solid fa-comment-dots"></i><span class="badge">1</span></a>
    <span class="role-pill">{{usuario.role}}</span>
    <div class="avatar-wrap">
      <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
      <i class="fa-solid fa-chevron-down chev"></i>

      <div class="avatar-dropdown">
        <div class="dropdown-header">
          <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
          <span>{{usuario.completeName}}</span>
        </div>
        <a href="/profile"><i class="fa-solid fa-user"></i> Ver perfil</a>
        <a href="#"><i class="fa-solid fa-briefcase"></i> Meu Portfólio</a>
        <a href="#"><i class="fa-solid fa-file-lines"></i> Serviços e Propostas</a>
        <a href="/settings"><i class="fa-solid fa-gear"></i> Configurações da Conta</a>
        <a href="#" class="dropdown-sair" id="sair"><i class="fa-solid fa-right-from-bracket"></i>Sair</a>
      </div>
    </div>
  </div>
</header>

<nav class="subnav">
  <a href="/home">Tela Inicial</a>
  <a href="/freelancers">Freelancers</a>
  <a href="/projects">Projetos</a>
  <a href="/support" class="active">Suporte</a>
</nav>

<main class="suporte-main">

  <!-- Hero + busca -->
  <section class="hero-suporte">
    <h1>Central de Suporte</h1>
    <p>Tire dúvidas, acompanhe chamados ou fale com nossa equipe.</p>
    <div class="busca-ajuda">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Como podemos ajudar? Ex: pagamento, contrato, verificação...">
    </div>
  </section>

  <!-- Categorias -->
  <section class="secao">
    <h2>Categorias de Ajuda</h2>
    <div class="categorias-grid">
      <a href="#" class="categoria-card">
        <i class="fa-solid fa-user"></i>
        <span>Conta e Perfil</span>
      </a>
      <a href="#" class="categoria-card">
        <i class="fa-solid fa-sack-dollar"></i>
        <span>Pagamentos e Recebimentos</span>
      </a>
      <a href="#" class="categoria-card">
        <i class="fa-solid fa-file-signature"></i>
        <span>Contratos e Prazos</span>
      </a>
      <a href="#" class="categoria-card">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Segurança e Verificação</span>
      </a>
      <a href="#" class="categoria-card categoria-alerta">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Denúncias e Disputas</span>
      </a>
      <a href="#" class="categoria-card">
        <i class="fa-solid fa-star"></i>
        <span>Avaliações e Reputação</span>
      </a>
    </div>
  </section>

  <!-- Reportar um problema (destaque) -->
  <section class="secao">
    <div class="report-card">
      <div class="report-topo">
        <div class="report-icone"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div>
          <h2>Reportar um Problema</h2>
          <p>Teve algum imprevisto com um contrato, pagamento ou comportamento suspeito? Conte pra gente — sua denúncia é analisada pela nossa equipe e o contrato relacionado fica sinalizado até a resolução.</p>
        </div>
      </div>

      <form class="report-form">
        <div class="form-row">
          <div class="form-field">
            <label for="tipo-problema">Tipo de problema</label>
            <select id="tipo-problema" class="field">
              <option>Cliente não realizou o pagamento</option>
              <option>Freelancer não entregou o serviço</option>
              <option>Conteúdo de perfil/portfólio suspeito</option>
              <option>Comportamento abusivo ou golpe</option>
              <option>Problema técnico na plataforma</option>
              <option>Outro</option>
            </select>
          </div>
          <div class="form-field">
            <label for="contrato-relacionado">Contrato ou projeto relacionado</label>
            <select id="contrato-relacionado" class="field">
              <option>Site Institucional Petshop</option>
              <option>Landing Page para Evento</option>
              <option>Não é sobre um contrato específico</option>
            </select>
          </div>
        </div>

        <div class="form-field">
          <label for="descricao-problema">Descreva o que aconteceu</label>
          <textarea id="descricao-problema" class="field" rows="4" placeholder="Explique com o máximo de detalhes possível, incluindo datas, se houver."></textarea>
        </div>

        <div class="form-field">
          <label for="anexo-problema">Anexar evidências (prints, arquivos)</label>
          <div class="upload-box">
            <i class="fa-solid fa-paperclip"></i>
            <span>Clique para anexar ou arraste os arquivos aqui</span>
          </div>
        </div>

        <button type="submit" class="btn-report"><i class="fa-solid fa-paper-plane"></i> Enviar Denúncia</button>
      </form>
    </div>
  </section>

  <!-- FAQ -->
  <section class="secao">
    <h2>Perguntas Frequentes</h2>
    <div class="faq-lista">

      <div class="faq-item open">
        <button class="faq-pergunta">
          Como funciona o pagamento dos projetos?
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="faq-resposta">
          <p>O pagamento é intermediado pela plataforma: o cliente deposita o valor no início do contrato, e o StartFreela libera para o freelancer somente após a entrega ser aprovada.</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-pergunta">
          O que significa o selo "Contrato Verificado"?
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="faq-resposta">
          <p>Indica que aquele trabalho foi realizado e concluído dentro da própria plataforma, com histórico auditado automaticamente pelo sistema — diferente de projetos externos adicionados manualmente ao portfólio.</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-pergunta">
          Como faço para verificar minha identidade?
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="faq-resposta">
          <p>Acesse Configurações da Conta &gt; Verificação de Identidade e envie um documento oficial com foto. A análise costuma levar até 48 horas.</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-pergunta">
          O que acontece se eu abrir uma denúncia?
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="faq-resposta">
          <p>Nossa equipe analisa o caso e pode entrar em contato com as partes envolvidas. Enquanto a denúncia estiver em análise, o contrato relacionado fica sinalizado e protegido.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- Meus chamados -->
  <section class="secao">
    <h2>Meus Chamados</h2>
    <div class="chamados-lista">

      <!-- <div class="chamado-item">
        <div class="chamado-info">
          <p class="chamado-titulo">Cliente não realizou o pagamento</p>
          <p class="chamado-meta">Aberto em 10/08/2026 · Protocolo #4821</p>
        </div>
        <span class="status-pill pending"><span class="dot"></span>Em análise</span>
      </div> -->

      <!-- <div class="chamado-item">
        <div class="chamado-info">
          <p class="chamado-titulo">Dúvida sobre verificação de identidade</p>
          <p class="chamado-meta">Aberto em 02/08/2026 · Protocolo #4756</p>
        </div>
        <span class="status-pill resolved"><span class="dot"></span>Resolvido</span>
      </div> -->

    </div>
  </section>

  <!-- Canais de contato -->
  <section class="secao">
    <h2>Fale Conosco</h2>
    <div class="canais-grid">
      <a href="#" class="canal-card">
        <i class="fa-brands fa-whatsapp"></i>
        <div>
          <p class="canal-titulo">WhatsApp</p>
          <p class="canal-desc">Resposta rápida em horário comercial</p>
        </div>
      </a>
      <a href="#" class="canal-card">
        <i class="fa-solid fa-envelope"></i>
        <div>
          <p class="canal-titulo">E-mail</p>
          <p class="canal-desc">suporte@startfreela.com</p>
        </div>
      </a>
      <a href="#" class="canal-card">
        <i class="fa-solid fa-comments"></i>
        <div>
          <p class="canal-titulo">Chat ao Vivo</p>
          <p class="canal-desc">Disponível das 8h às 18h</p>
        </div>
      </a>
    </div>
  </section>

</main>

<script src="/js.components/header-dropdown.js"></script>
<script src="/js.components/accordion.js"></script>
<script type="module" src="/js/support.js"></script>
</body>
</html>

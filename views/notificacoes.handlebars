<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Central de Notificações - Protótipo v2</title>
    <!-- Tailwind CSS para estilização rápida e responsiva -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="/css/notificacoes.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            blue: '#1E40AF',      // Azul Primário
                            blueHover: '#1D4ED8',
                            blueLight: '#EFF6FF',
                            yellow: '#F59E0B',    // Amarelo Destaque
                            yellowHover: '#D97706',
                            yellowLight: '#FEF3C7',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col transition-colors duration-200">

   <header class="topbar">
  <a href="/home" class="logo">
      <img id="logo-image" src="/img/logo-deitada.png" alt="StartFreela">
  </a>

  <div class="search-wrap">
    <i id="icon" class="fa-solid fa-magnifying-glass"></i>
    <input type="text" name="search" id="search" placeholder="Busque em StartFreela...">
  </div>

  <div class="top-actions">
    <div class="icon-btn"><i class="fa-solid fa-bell"></i><span class="badge">1</span></div>
    <a class="icon-btn" href="/messages"><i class="fa-solid fa-comment-dots"></i><span class="badge">1</span></a>
    <span class="role-pill">{{usuario.role}}</span>
    <div class="avatar-wrap">
      <div class="avatar"><img id="foto-de-perfil" src="/img/foto-do-perfil.png" alt=""></div>
      <i class="fa-solid fa-chevron-down chev"></i>

      <div class="avatar-dropdown">
        <div class="dropdown-header">
          <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
          <span>{{usuario.completeName}}</span>
        </div>
        <a href="/profile"><i class="fa-solid fa-user"></i> Ver perfil</a>
        <a href="#"><i class="fa-solid fa-briefcase"></i> Meu Portfólio</a>
        <a href="#"><i class="fa-solid fa-file-lines"></i> Serviços e Propostas</a>
        <a href="/settings"><i class="fa-solid fa-gear"></i> Configurações da Conta</a>
        <a href="#" class="dropdown-sair" id="sair" ><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
      </div>
    </div>
  </div>
</header>

<nav class="subnav">
  <a href="/home">Tela Inicial</a>
  <a href="/freelancers">Freelancers</a>
  <a href="/projects">Projetos</a>
  <a href="/support">Suporte</a>
</nav>

    <!-- Conteúdo Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <h1>Notificações</h1>
        <!-- Dashboard de Métricas Rápidas -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <!-- Card 1 -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500">Não Lidas</p>
                    <p class="text-2xl font-black text-brand-blue mt-1" id="stat-unread">4</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-brand-yellowLight text-brand-yellow flex items-center justify-center font-bold">
                    <i data-lucide="mail-x" class="w-6 h-6"></i>
                </div>
            </div>
            <!-- Card 2 -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500">Urgentes / Ação Necessária</p>
                    <p class="text-2xl font-black text-brand-yellow mt-1" id="stat-urgent">2</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                    <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                </div>
            </div>
            <!-- Card 3 -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500">Total Recebidas Hoje</p>
                    <p class="text-2xl font-black text-slate-800 mt-1" id="stat-total">6</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center font-bold">
                    <i data-lucide="inbox" class="w-6 h-6"></i>
                </div>
            </div>
        </div>

        <!-- Filtros e Busca -->
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm mb-6 flex flex-col md:flex-row gap-4 items-center justify-between">
            <!-- Abas -->
            <div class="flex items-center gap-1 overflow-x-auto w-full md:w-auto pb-2 md:pb-0">
                <button id="category" class="tab-btn active font-medium text-sm px-4 py-2 rounded-xl bg-brand-blue text-white shadow-sm transition">
                    Todas
                </button>
                <button id="category" class="tab-btn font-medium text-sm px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition">
                    Não Lidas
                </button>
                <button id="category" class="tab-btn font-medium text-sm px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition">
                    Sistema
                </button>
                <button id="category" class="tab-btn font-medium text-sm px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition">
                    Financeiro
                </button>
                <button id="category" class="tab-btn font-medium text-sm px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition">
                    Segurança
                </button>
            </div>

            <!-- Campo de Busca -->
            <div class="relative w-full md:w-72">
                <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" id="search-input" onkeyup="handleSearch()" placeholder="Buscar notificação..." class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-brand-blue focus:bg-white transition">
            </div>
        </div>

        <!-- Lista de Notificações com Agrupamento de Tempo -->
        <div id="notifications-container" class="space-y-6">
            <!-- As notificações são inseridas dinamicamente via JS -->
        </div>

    </main>

    <!-- Slide-Over (Painel Lateral de Detalhes) -->
    <a id="detail-panel-overlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"></a>
    <aside id="detail-panel" class="fixed top-0 right-0 h-full w-full max-w-md bg-white z-50 shadow-2xl border-l border-slate-200 translate-x-full slide-panel flex flex-col">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between bg-slate-50">
            <div class="flex items-center gap-2">
                <span id="panel-badge" class="px-2.5 py-1 text-xs font-semibold rounded-md bg-brand-blueLight text-brand-blue">Categoria</span>
                <span id="panel-time" class="text-xs text-slate-400">Hora</span>
            </div>
            <button id="closeDetail" class="p-2 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-200/50 transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <div class="p-6 flex-1 overflow-y-auto custom-scrollbar space-y-4">
            <h2 id="panel-title" class="text-xl font-bold text-slate-900">Título da Notificação</h2>
            <div class="p-4 bg-brand-blueLight/50 border border-brand-blue/20 rounded-xl text-sm text-slate-700 leading-relaxed" id="panel-content">
                Detalhes completos da mensagem vão aparecer aqui...
            </div>
            <div class="pt-4 border-t border-slate-100 space-y-3">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Ações Sugeridas</p>
                <button id="panel-action-btn" class="w-full py-2.5 bg-brand-yellow hover:bg-brand-yellowHover text-slate-900 font-bold text-sm rounded-xl transition shadow-md shadow-amber-500/10 flex items-center justify-center gap-2">
                    <i data-lucide="external-link" class="w-4 h-4"></i>
                    Executar Ação Principal
                </button>
            </div>
        </div>
        <div class="p-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
            <button id="panel-delete-btn" class="text-xs font-semibold text-rose-600 hover:text-rose-800 flex items-center gap-1">
                <i data-lucide="trash-2" class="w-4 h-4"></i> Excluir Notificação
            </button>
            <button class="text-xs font-semibold text-slate-500 hover:text-slate-700">
                Fechar
            </button>
        </div>
    </aside>

    <!-- Modal de Configurações -->
    <div id="config-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-200">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-xl border border-slate-200 p-6 space-y-6">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold text-slate-900">Preferências de Notificação</h3>
                <button onclick="closeConfigModal()" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>
            <div class="space-y-4 text-sm">
                <label class="flex items-center justify-between p-3 rounded-xl border border-slate-100 hover:bg-slate-50 cursor-pointer">
                    <span class="font-medium text-slate-700">Notificações por E-mail</span>
                    <input type="checkbox" checked class="w-4 h-4 text-brand-blue rounded border-slate-300 focus:ring-brand-blue">
                </label>
                <label class="flex items-center justify-between p-3 rounded-xl border border-slate-100 hover:bg-slate-50 cursor-pointer">
                    <span class="font-medium text-slate-700">Alertas Financeiros Urgentes</span>
                    <input type="checkbox" checked class="w-4 h-4 text-brand-yellow rounded border-slate-300 focus:ring-brand-yellow">
                </label>
                <label class="flex items-center justify-between p-3 rounded-xl border border-slate-100 hover:bg-slate-50 cursor-pointer">
                    <span class="font-medium text-slate-700">Sons de Alerta</span>
                    <input type="checkbox" class="w-4 h-4 text-brand-blue rounded border-slate-300 focus:ring-brand-blue">
                </label>
            </div>
            <button onclick="closeConfigModal()" class="w-full py-2.5 bg-brand-blue text-white font-bold rounded-xl hover:bg-brand-blueHover transition">Salvar Alterações</button>
        </div>
    </div>
    <script type="module" src="/js/notificacoes.js" defer></script>
    <script src="/js.components/header-dropdown.js"></script>
</body>
</html>
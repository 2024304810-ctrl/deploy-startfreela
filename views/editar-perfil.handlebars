<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Perfil - StartFreela</title>
    <link rel="stylesheet" href="/css/editar-perfil.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <script defer>
        window.dadosPagina = {
            usuario: {{{json usuario}}},
        }
    </script>
</head>

<body>
    <header class="topbar">
  <a href="/home" class="logo">
      <img id="logo-image" src="/img/logo-deitada.png" alt="StartFreela">
    </a>

  <div class="search-wrap">
    <i id="icon" class="fa-solid fa-magnifying-glass"></i>
    <input type="text" name="search" id="search" placeholder="Busque em StartFreela...">
  </div>

  <div class="top-actions">
    <a class="icon-btn" href="/notifications"><i class="fa-solid fa-bell"></i><span class="badge">1</span></a>
    <a class="icon-btn" href="/messages"><i class="fa-solid fa-comment-dots"></i><span class="badge">1</span></a>
    <span class="role-pill">{{usuario.role}}</span>
    <div class="avatar-wrap">
      <div class="avatar"><img id="foto-de-perfil" src="/img/foto-do-perfil.png" alt=""></div>
      <i class="fa-solid fa-chevron-down chev"></i>

      <div class="avatar-dropdown">
        <div class="dropdown-header">
          <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
          <span>{{usuario.completeName}}</span>
        </div>
        <a href="/profile"><i class="fa-solid fa-user"></i> Ver perfil</a>
        <a href="#"><i class="fa-solid fa-briefcase"></i> Meu Portfólio</a>
        <a href="#"><i class="fa-solid fa-file-lines"></i> Serviços e Propostas</a>
        <a href="/settings"><i class="fa-solid fa-gear"></i> Configurações da Conta</a>
        <a class="dropdown-sair" id="sair" ><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
      </div>
    </div>
  </div>
</header>

<nav class="subnav">
  <a href="/home">Tela Inicial</a>
  <a href="/freelancers">Freelancers</a>
  <a href="/projects">Projetos</a>
  <a href="/support">Suporte</a>
</nav>

    <main class="editar-perfil-container">
        <div class="page-title">
            <div class="title-icon">
                <i class="fa-solid fa-user"></i>
            </div>
            <div>
                <h1>Editar Perfil</h1>
                <p>Atualize suas informações e mantenha seu perfil sempre em dia.</p>
            </div>
        </div>

        <div class="perfil-content">
            <aside class="perfil-sidebar">

                <div class="foto-container">
                    <div class="foto-wrapper">
                        <img id="fotoPerfil" src="/img/foto-do-perfil.png" alt="Foto do perfil">
                        <label for="inputFoto" class="editar-foto">
                            <i class="fa-solid fa-camera"></i>
                        </label>
                    </div>
                    <input type="file"id="inputFoto"accept="image/*"hidden>
                    <label for="inputFoto" class="botao-foto"><i class="fa-solid fa-camera"></i>Alterar foto</label>
                </div>

                <div class="menu-perfil">
                    <button class="menu-item ativo" data-section="informacoes"><i class="fa-solid fa-user"></i><span>Informações Pessoais</span></button>
                    <button class="menu-item" data-section="redes"><i class="fa-solid fa-link"></i><span>Redes Sociais</span></button>
                    <button class="menu-item" data-section="sobre"><i class="fa-regular fa-file-lines"></i><span>Sobre mim</span></button>
                </div>

            </aside>

            <section class="form-card">

                <div class="form-section ativa" id="informacoes">
                    <div class="section-title">

                        <div class="section-icon">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div>
                            <h2>Informações Pessoais</h2>
                            <p>Seus dados básicos de identificação.</p>
                        </div>

                    </div>

                    <div class="campo">
                        <label>Nome completo <span>*</span></label>
                        <input type="text" id="nome" value="{{usuario.completeName}}">
                    </div>

                    <div class="linha-campos">
                        <div class="campo">
                            <label>Nome de usuário <span>*</span></label>
                            <input type="text" id="username" value="{{usuario.username}}">
                        </div>

                        <div class="campo">
                            <label> Data de nascimento <span>*</span></label>
                            <div class="input-icon">
                                <i class="fa-regular fa-calendar"></i>
                                <input type="date" id="dataNascimento" value="2005-04-15">
                        </div>
                    </div>

                    <div class="campo">
                        <label>Cidade</label>
                        <input type="text" id="cidade" value="{{usuario.localizacao.cidade}}">
                    </div>

                    <div class="campo">
                        <label>Estado</label>
                        <input type="text" id="estado" value="{{usuario.localizacao.estado}}">
                    </div>

                    <div class="campo">
                        <label>CEP</label>
                        <input type="text" id="CEP" placeholder="">
                    </div>

                    <div class="campo">
                        <label>Endereço</label>
                        <input type="text" id="endereco" placeholder="Seu endereço">
                    </div>

                    <div class="campo">
                        <label>Telefone</label>
                        <div class="input-icon">
                            <i class="fa-solid fa-phone"></i>
                            <input type="tel" id="telefone" maxlength="11" value="{{usuario.contato.phone}}">
                        </div>
                    </div>

                    <div class="campo">
                        <label>Email <span>*</span></label>
                        <div class="input-icon">
                            <i class="fa-solid fa-envelope"></i>
                            <input type="email" id="email" value="{{usuario.contato.email}}">
                        </div>
                    </div>

                    </div>

                    <div class="senha-area">
                        <div class="senha-info">
                            <i class="fa-solid fa-lock"></i>
                            <div>
                                <h3>Senha</h3>
                                <p>Mantenha sua conta segura.</p>
                            </div>
                        </div>
                        <button type="button" class="botao-senha" id="alterarSenha"><i class="fa-solid fa-key"></i> Alterar senha</button>
                    </div>
                </div>

                <div class="form-section" id="redes">
                    <div class="section-title">
                        <div class="section-icon">
                            <i class="fa-solid fa-link"></i>
                        </div>
                        <div>
                            <h2>Redes Sociais</h2>
                            <p>Adicione seus perfis profissionais.</p>
                        </div>
                    </div>

                    <div class="campo">
                        <label>Instagram</label>
                        <div class="input-icon">
                            <i class="fa-brands fa-instagram"></i>
                            <input type="text" id="inp-instagram" placeholder="@seuusuario">
                        </div>
                    </div>


                    <div class="campo">
                        <label>GitHub</label>
                        <div class="input-icon">
                            <i class="fa-brands fa-github"></i>
                            <input type="text" id="inp-github" placeholder="github.com/seuusuario">
                        </div>
                    </div>

                    <div class="campo">
                        <label>LinkedIn</label>
                        <div class="input-icon">
                            <i class="fa-brands fa-linkedin"></i>
                            <input type="text" id="inp-linkedin" placeholder="linkedin.com/in/seuusuario">
                        </div>
                    </div>

                    <div class="campo">
                        <label>Youtube</label>
                        <div class="input-icon">
                            <i class="fa-brands fa-youtube"></i>
                            <input type="text" id="inp-youtube" placeholder="linkedin.com/in/seuusuario">
                        </div>
                    </div>

                    <div class="campo">
                        <label>Facebook</label>
                        <div class="input-icon">
                            <i class="fa-brands fa-facebook"></i>
                            <input type="text" id="inp-facebook" placeholder="linkedin.com/in/seuusuario">
                        </div>
                    </div>
                </div>

                <div class="form-section"id="sobre">

                    <div class="section-title">
                        <div class="section-icon">
                            <i class="fa-regular fa-file-lines"></i>
                        </div>

                        <div>
                            <h2>Sobre mim</h2>
                            <p>Conte um pouco mais sobre você.</p>
                        </div>
                    </div>

                    <div class="campo">
                        <label>Especialidade profissional</label>
                        <input type="text" value="{{usuario.profissao}}">
                    </div>

                    <div class="campo">
                        <label>Habilidades</label>
                        <input type="text" placeholder="Ex: Node.js, MongoDB, JavaScript">
                    </div>

                    <div class="campo">
                        <label>Descrição</label>
                        <textarea class="textarea-grande" id="bio" value="{{usuario.sobreMim}}"></textarea>
                    </div>

                </div>

                <div class="botoes">
                    <button type="button" class="cancelar" id="cancelar">Cancelar</button>
                    <button type="button" class="salvar" id="salvar"><i class="fa-solid fa-floppy-disk"></i> Salvar Alterações</button>
                </div>
            </section>
        </div>
    </main>
    <script type="module" src="/js/editProfile.js" defer></script>
    <script src="/js.components/header-dropdown.js" defer></script>
</body>
</html>
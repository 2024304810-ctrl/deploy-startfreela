<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StartFreela - Conversa</title>
<link rel="stylesheet" href="/css/tela-conversa.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>

<header class="topbar">
  <a href="/home" class="logo">
      <img id="logo-image" src="/img/logo-deitada.png" alt="StartFreela">
    </a>

  <div class="search-wrap">
    <i id="icon" class="fa-solid fa-magnifying-glass"></i>
    <input type="text" name="search" id="search" placeholder="Busque em StartFreela...">
  </div>

  <div class="top-actions">
    <a class="icon-btn" href="/notifications"><i class="fa-solid fa-bell"></i><span class="badge">1</span></a>
    <div class="icon-btn"><i class="fa-solid fa-comment-dots"></i><span class="badge">3</span></div>
    <span class="role-pill">{{usuario.role}}</span>
    <div class="avatar-wrap">
      <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
      <i class="fa-solid fa-chevron-down chev"></i>

      <div class="avatar-dropdown">
        <div class="dropdown-header">
          <div class="avatar"><img src="/img/foto-do-perfil.png" alt=""></div>
          <span>{{usuario.completeName}}</span>
        </div>
        <a href="/profile"><i class="fa-solid fa-user"></i> Ver perfil</a>
        <a href="#"><i class="fa-solid fa-briefcase"></i> Meu Portfólio</a>
        <a href="#"><i class="fa-solid fa-file-lines"></i> Serviços e Propostas</a>
        <a href="/settings"><i class="fa-solid fa-gear"></i> Configurações da Conta</a>
        <a href="#" class="dropdown-sair" id="sair"><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
      </div>
    </div>
  </div>
</header>

<nav class="subnav">
  <a href="/home">Tela Inicial</a>
  <a href="/freelancers">Freelancers</a>
  <a href="/projects">Projetos</a>
  <a href="/support">Suporte</a>
</nav>

<main>
  <div class="layout-conversa">
    <section class="panel-conversa">

      <div class="conversa-header-chat">
        <a href="/messages" class="btn-voltar" title="Voltar"><i class="fa-solid fa-arrow-left"></i></a>
        <div class="avatar-round-chat"><img src="/img/icone-user.png" alt=""></div>
        <div class="chat-identidade">
          <p class="chat-nome">{{destinatario.username}} <i class="fa-solid fa-shield-halved chat-selo" title="Identidade verificada"></i></p>
          <p class="chat-status"><span class="dot-online"></span>Online</p>
        </div>
        <button class="chat-menu-btn" type="button"><i class="fa-solid fa-ellipsis-vertical"></i></button>
      </div>

      <div class="contexto-projeto">
        <i class="fa-solid fa-briefcase"></i>
        <span>Sobre o projeto: <b>Site Institucional para Clínica</b></span>
        <a href="/projects" class="contexto-link">Ver projeto</a>
      </div>

      <div class="mensagens-area" id="mensagens">
        <!--
        <div class="divisor-data"><span>Hoje</span></div>

        <div class="bolha recebida">
          <p>Oi Gabriel! Vi sua proposta pro projeto do site da clínica, gostei bastante do seu portfólio 😊</p>
          <span class="bolha-hora">09:14</span>

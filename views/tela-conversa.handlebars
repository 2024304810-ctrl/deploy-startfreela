      </div>

      <form class="input-mensagem">
        <button class="btn-anexo" type="button" title="Anexar arquivo"><i class="fa-solid fa-paperclip"></i></button>
        <input type="text" id="message-text" placeholder="Digite uma mensagem...">
        <button class="btn-enviar" type="submit" title="Enviar"><i class="fa-solid fa-paper-plane"></i></button>
      </form>

    </section>
  </div>
</main>

<script src="/js.components/header-dropdown.js" defer></script>
<script type="module" src="/js/chat.js"></script>

</body>
</html>
